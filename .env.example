# ==============================================================================
# RNENIS NURSING — ENVIRONMENT CONFIGURATION
# Copy this file to `.env.local` and fill in the values, then restart the app.
#   cp .env.example .env.local
# ==============================================================================

# ------------------------------------------------------------------------------
# ⚠️  BACKEND — REQUIRED (ask the backend developer for these)
# ------------------------------------------------------------------------------

# Which backend the frontend should talk to: "dotnet" | "laravel" | "fastapi"
NEXT_ACTIVE_BACKEND=

# .NET backend base URL (no trailing slash)
# Example: http://localhost:5000
NEXT_PUBLIC_DOTNET_BASE_URL=

# Laravel backend base URL(s), comma-separated. The first entry is used.
# Example: http://localhost:8000
NEXT_PUBLIC_LARAVEL_BASE_URL=

# FastAPI backend base URL(s), comma-separated. The SECOND entry is used.
# Example: http://localhost:8000,http://localhost:8001
NEXT_PUBLIC_FASTAPI_BASE_URL=

# ------------------------------------------------------------------------------
# APP INFO — optional (sensible defaults already exist in code)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Rhenis Nursing
NEXT_PUBLIC_APP_TITLE=Rhenis Nursing
NEXT_PUBLIC_APP_ACRONNYM=RN
NEXT_PUBLIC_APP_DESCRIPTION=Nursing Exam Preparation and Practice Platform
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_APP_ENV=live
NEXT_PUBLIC_APP_DEBUG=false
NEXT_PUBLIC_APP_TIMEZONE=UTC
NEXT_PUBLIC_APP_LOCALE=en
NEXT_PUBLIC_APP_DOMAIN=http://localhost:3000

# ------------------------------------------------------------------------------
# CONTACT / SUPPORT — optional
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPPORT_EMAIL=support@rhenisnursing.com
NEXT_PUBLIC_SYSTEM_EMAIL=support@rhenisnursing.com
NEXT_PUBLIC_HELP_EMAIL=support@rhenisnursing.com
